# Resend (https://resend.com) — used by src/app/api/contact and src/app/api/specialty
# to send form submissions to smb@theodigogroup.com.
RESEND_API_KEY=

# Must be an address on a domain verified in your Resend account (DNS records added
# and confirmed). Until a domain is verified, leave unset to fall back to Resend's
# shared sandbox address (onboarding@resend.dev) — deliverability is not guaranteed
# with that fallback and it should not be relied on in production.
RESEND_FROM_EMAIL="Odigo SMB Website <noreply@theodigogroup.com>"
